# Copiar para .env e preencher. .env nunca deve ser commitado (ver .gitignore).

FRED_API_KEY=

# Credenciais AWS: prefira ~/.aws/credentials (aws configure) em vez de
# colocar aqui. Só defina estas duas se o host não tiver esse arquivo
# (ex.: container Ubuntu sem aws configure rodado).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
